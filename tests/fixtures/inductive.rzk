#lang rzk-1

#data bool := false | true

#data nat := zero | suc (n : nat)

#data vec
  ( A : U)
  : nat → U
  :=
    nil : vec A zero
  | cons (n : nat) (x : A) (xs : vec A n) : vec A (suc n)

#define plus (n m : nat) : nat
  := match n
      ( zero ⇒ m
      | suc k ih ⇒ suc ih)

#define not (b : bool) : bool
  := match b (false => true | true => false)

#define vhead (A : U) (n : nat) (xs : vec A (suc n)) : A
  := match xs into (\ k v → match k (zero ⇒ Unit | suc j jh ⇒ A))
      ( nil ⇒ unit
      | cons m x tail th ⇒ x)

#define meet-is-a-lower-bound
  ( a b : 𝕀)
  ( f : (x : 𝕀 | (x <= a) /\ (x <= b)) -> U)
  : U
  := f (inf a b)

#define join-unicode (a b : 𝕀) : 𝕀
  := a ⊔ (a ⊓ b)

#define transport
  ( A : U) (C : A → U) (x y : A) (p : x =_{A} y) (u : C x)
  : C y
  := idJ (A , x , \ y' _ → C x → C y' , \ v → v , y , p) u

#define ap
  ( A B : U) (f : A → B) (x y : A) (p : x =_{A} y)
  : f x =_{B} f y
  := idJ (A , x , \ y' _ → f x =_{B} f y' , refl , y , p)

#data circle
  :=
    pt
  | turn : pt =_{circle} pt
  eliminate with ind-circle
    : ( C : circle → U)
    → ( b : C pt)
    → ( ℓ : transport circle C pt pt turn b = b)
    → ( x : circle)
    → C x
  compute with compute-rec-circle-turn
    : ( C : U)
    → ( b : C)
    → ( ℓ : b = b)
    → ap circle C (rec-circle C b ℓ) pt pt turn = ℓ

#define circle-id (x : circle) : circle
  := match x (pt ⇒ pt | turn ⇒ turn)
